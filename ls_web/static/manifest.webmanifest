{
  "name": "LocalSunoDb",
  "short_name": "LocalSunoDb",
  "id": "/localsunodb",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#214f3a",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/ls-static/ls_web/static/LS-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/ls-static/ls_web/static/LS-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
